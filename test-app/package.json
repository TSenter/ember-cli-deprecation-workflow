{
  "name": "test-app",
  "version": "3.4.0",
  "description": "Provides a much needed workflow to managing deprecations.",
  "keywords": [],
  "repository": "https://github.com/ember-cli/ember-cli-deprecation-workflow/",
  "license": "MIT",
  "author": "",
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "scripts": {
    "build": "ember build --environment=production",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\"",
    "lint:css": "stylelint \"**/*.css\" --allow-empty-input --cache",
    "lint:css:fix": "stylelint \"**/*.css\" --allow-empty-input --fix",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\"",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "start": "ember serve",
    "test": "ember test",
    "test:ember-compatibility": "ember try:one"
  },
  "dependencies": {},
  "devDependencies": {
    "@babel/eslint-parser": "^7.22.15",
    "@babel/plugin-proposal-decorators": "^7.23.2",
    "@ember/optional-features": "^2.0.0",
    "@ember/test-helpers": "5.2.2",
    "@ember/test-waiters": "^4.1.0",
    "@embroider/broccoli-side-watch": "^1.1.0",
    "@embroider/macros": "^1.18.0",
    "@embroider/test-setup": "^3.0.2",
    "@eslint/js": "^9.26.0",
    "@glimmer/component": "^1.1.2",
    "@glimmer/tracking": "^1.1.2",
    "@ijlee2-frontend-configs/ember-template-lint": "^1.1.0",
    "@ijlee2-frontend-configs/eslint-config-ember": "^1.1.0",
    "@ijlee2-frontend-configs/prettier": "^1.0.0",
    "@ijlee2-frontend-configs/stylelint": "^1.0.0",
    "broccoli-asset-rev": "^3.0.0",
    "concurrently": "^9.1.2",
    "ember-auto-import": "^2.6.3",
    "ember-cli": "^6.4.0",
    "ember-cli-babel": "^8.2.0",
    "ember-cli-clean-css": "^3.0.0",
    "ember-cli-dependency-checker": "^3.3.2",
    "ember-cli-deprecation-workflow": "3.4.0",
    "ember-cli-htmlbars": "^6.3.0",
    "ember-cli-inject-live-reload": "^2.1.0",
    "ember-cli-sri": "^2.1.1",
    "ember-cli-terser": "^4.0.2",
    "ember-load-initializers": "^2.1.2",
    "ember-page-title": "^9.0.2",
    "ember-qunit": "^9.0.3",
    "ember-resolver": "^13.1.1",
    "ember-source": "^6.4.0",
    "ember-source-channel-url": "^3.0.0",
    "ember-template-lint": "^7.7.0",
    "ember-try": "^4.0.0",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-ember": "^11.11.1",
    "eslint-plugin-n": "^16.2.0",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-qunit": "^8.0.1",
    "lerna-changelog": "^2.2.0",
    "loader.js": "^4.7.0",
    "prettier": "^3.5.3",
    "qunit": "^2.20.0",
    "qunit-dom": "^2.0.0",
    "release-plan": "^0.9.0",
    "stylelint": "^16.19.1",
    "stylelint-config-standard": "^34.0.0",
    "stylelint-prettier": "^4.0.2",
    "webpack": "^5.89.0"
  },
  "peerDependencies": {
    "ember-source": ">= 3.28.0"
  },
  "engines": {
    "node": ">= 18"
  },
